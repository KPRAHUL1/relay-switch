# Relay — copy to .env and fill in the two values that have no default.
#
#   cp .env.example .env

# ── Where Switch is ───────────────────────────────────────────────────────────
# The AGENT BRIDGE base URL, which is usually NOT the Gateway URL. Operators
# reach the Gateway (:3000 by default); agents reach the bridge (:8000).
#
# Check it before anything else:  curl http://localhost:8000/health
#   healthy  -> right base URL
#   401      -> right host, wrong path
RELAY_SWITCH_BASE_URL=http://localhost:8000

# AGENT_REGISTRATION_TOKEN from your Switch server's own .env.
#
# Used exactly once, to register Relay, and rejected everywhere else. The
# Gateway user it identifies becomes Relay's owner, and Relay's permissions
# are inherited from them — so register with an account that can create rooms.
#
# After the first successful start, Relay has an API key on file in
# .relay/relay.sqlite3 and never reads this again.
RELAY_REGISTRATION_TOKEN=

# ── The desk ──────────────────────────────────────────────────────────────────
# Relay's name in Switch. This is what people and agents type: `@relay ...`
RELAY_AGENT_NAME=relay

# The room Relay treats as the desk, resolved BY NAME at startup, so you never
# have to paste a room id. Must match the room the desk template created.
RELAY_DESK_ROOM_NAME=relay-desk

# The room role Relay escalates to. Whoever assumes it gets the pages.
RELAY_DUTY_ROLE=duty

# ── Timing ────────────────────────────────────────────────────────────────────
# Silence on an open case before Relay nudges. Lower it to 2 while demoing.
RELAY_STALL_MINUTES=20

# How often the clocks are evaluated.
RELAY_TICK_SECONDS=30

# ── The board ─────────────────────────────────────────────────────────────────
RELAY_API_PORT=8787

# Set to true for ONE start to re-register under the same name, if you have
# lost .relay/ and Switch still has the old agent. Leave false otherwise.
RELAY_REGISTER_OVERWRITE=false
